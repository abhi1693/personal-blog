{
  "name": "personal-blog",
  "version": "0.3.18",
  "description": "An impressive Sanity.io starter template with Next.js 16 and Tailwind 4",
  "author": "Abhimanyu Saharan <desk.abhimanyu@gmail.com> (https://blog.abhimanyu-saharan.com)",
  "scripts": {
    "dev": "next dev",
    "build": "npm run manifest && next build",
    "start": "next start",
    "lint": "eslint src scripts",
    "format": "prettier --write src/ scripts/",
    "manifest": "DO_NOT_TRACK=1 sanity manifest extract --path public/admin/static",
    "typegen": "sanity schema extract --path ./src/sanity/schema.json && sanity typegen generate",
    "typecheck": "tsc --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node tests/run-tests.js && npm run test:dependency-security && npm run test:runtime-build",
    "test:runtime-build": "node scripts/check-image-preflight.cjs",
    "test:dependency-security": "node --test scripts/check-braces.cjs"
  },
  "dependencies": {
    "@next/third-parties": "^16.4.2",
    "@portabletext/markdown": "^2.6.0",
    "@portabletext/to-html": "^6.0.0",
    "@sanity/assist": "^6.2.5",
    "@sanity/cli": "^8.22.1",
    "@sanity/code-input": "^7.3.13",
    "@sanity/dashboard": "^6.0.22",
    "@sanity/document-internationalization": "^6.2.43",
    "@sanity/image-url": "^2.1.1",
    "@sanity/language-filter": "^5.0.23",
    "@sanity/preview-url-secret": "^4.1.5",
    "@sanity/ui": "^4.4.10",
    "@sanity/vision": "^6.20.0",
    "@tailwindcss/postcss": "^4.3.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "clsx": "^2.1.1",
    "feed": "^6.0.0",
    "framer-motion": "^14.6.0",
    "googleapis": "^187.0.0",
    "next": "^16.4.2",
    "next-sanity": "^13.3.4",
    "nuqs": "^2.10.2",
    "octokit": "^5.0.5",
    "react": "^19.3.1",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-lite-youtube-embed": "^3.7.0",
    "resend": "^6.34.1",
    "rss-parser": "^3.13.0",
    "sanity": "^6.20.0",
    "sanity-plugin-internationalized-array": "^5.3.6",
    "sanity-plugin-media": "^6.4.0",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "styled-components": "^6.6.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.2",
    "@sanity/eslint-config-studio": "^6.0.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axios": "^1.20.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "xml2js": "^0.6.2",
    "braces": "file:packages/braces"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "^3.15.2",
      "smol-toml": "^1.9.1"
    },
    "braces": "$braces"
  }
}
